{
  "name": "cyberdojo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test:shell": "tsx scripts/check-shell.ts",
    "test:sim": "tsx scripts/check-sim-tools.ts",
    "test:missions": "tsx scripts/check-missions.ts",
    "test:content": "tsx scripts/check-content.ts",
    "test:drills": "tsx scripts/check-drills.ts",
    "test": "pnpm test:shell && pnpm test:sim && pnpm test:missions && pnpm test:drills && pnpm test:content && pnpm build && pnpm test:auth",
    "user:reset": "tsx scripts/reset-password.ts",
    "test:auth": "tsx scripts/check-auth.ts"
  },
  "dependencies": {
    "marked": "15.0.12",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
