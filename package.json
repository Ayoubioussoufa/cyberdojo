{
  "name": "cyberdojo",
  "version": "0.2.1",
  "repository": "https://github.com/Ayoubioussoufa/cyberdojo",
  "license": "(MIT AND CC-BY-NC-SA-4.0)",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "tutor:index": "tsx scripts/build-tutor-index.ts",
    "desktop:dev": "tsx scripts/desktop.ts dev",
    "desktop:start": "tsx scripts/desktop.ts start",
    "desktop:dist": "tsx scripts/desktop.ts dist",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p desktop",
    "test:shell": "tsx scripts/check-shell.ts",
    "test:sim": "tsx scripts/check-sim-tools.ts",
    "test:missions": "tsx scripts/check-missions.ts",
    "test:content": "tsx scripts/check-content.ts",
    "test:i18n": "tsx scripts/check-i18n.ts",
    "test:drills": "tsx scripts/check-drills.ts",
    "test:prompt": "tsx scripts/check-prompt.ts",
    "test:tutor": "tsx scripts/check-tutor.ts",
    "test:workshop": "tsx scripts/check-workshop.ts",
    "audit:coverage": "tsx scripts/coverage/audit.ts",
    "test:coverage": "tsx scripts/coverage/audit.ts --check",
    "audit:tools": "tsx scripts/tools/index.ts",
    "test:tools": "tsx scripts/tools/index.ts --check",
    "test": "pnpm test:shell && pnpm test:sim && pnpm test:missions && pnpm test:drills && pnpm test:prompt && pnpm test:workshop && pnpm tutor:index && pnpm test:tutor && pnpm test:content && pnpm test:i18n && pnpm test:coverage && pnpm test:tools && pnpm build && pnpm test:auth && pnpm test:metrics",
    "user:reset": "tsx scripts/reset-password.ts",
    "test:auth": "tsx scripts/check-auth.ts",
    "test:metrics": "tsx scripts/check-metrics.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "marked": "15.0.12",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
